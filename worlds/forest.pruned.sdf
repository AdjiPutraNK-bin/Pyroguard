          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>180</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>
      
      
      <link name="camera_link">
        <pose>0.12 0 0.08 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.0001</iyy>
            <iyz>0.0</iyz>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.05 0.02</size>
            </box>
          </geometry>
          <material>
